# ─────────────────────────────────────────────────────────────
# .gitignore : 깃허브(GitHub)에 "절대 올리면 안 되는 파일" 목록입니다.
# 여기에 적힌 파일은 인터넷에 공개되지 않습니다.  ← 보안의 핵심!
# ─────────────────────────────────────────────────────────────

# ▼ API 키·토큰이 들어있는 비밀 파일 (절대 공개 금지)
.env

# ▼ 파이썬이 자동으로 만드는 임시/캐시 파일들 (올릴 필요 없음)
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# ▼ 가상환경 폴더 (각자 PC에서 만드는 것이라 공유 불필요)
venv/
.venv/
env/

# ▼ 에디터·OS가 만드는 부산물
.vscode/
.DS_Store
Thumbs.db
